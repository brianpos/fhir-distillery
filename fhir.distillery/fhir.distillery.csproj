<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>fhir_distillery</RootNamespace>
		<IsPackable>true</IsPackable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>fhir-distillery</ToolCommandName>
		<PackageOutputPath>..\nupkg</PackageOutputPath>
		<PackageProjectUrl>https://github.com/brianpos/fhir-distillery</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/brianpos/fhir-distillery</RepositoryUrl>
		<PackageReadmeFile>Readme.md</PackageReadmeFile>
		<!-- Emit the XML doc file so the logical model generator can read /// comments -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- The tool is not a documented library, so don't warn on missing XML comments -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.Specification.Data.R4" Version="5.13.4" />
    <PackageReference Include="Hl7.Fhir.Specification.R4" Version="5.13.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="System.CommandLine.NamingConventionBinder" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>


</Project>
